# Copy to .env and fill in. Everything here has a working default except the key.

# --- Model -------------------------------------------------------------
# Not needed if you only ever run USE_STUB=1.
ANTHROPIC_API_KEY=sk-ant-...
MODEL_ID=claude-opus-5
# Parsing and equivalence judgement are extraction tasks; low effort is the
# right latency/quality trade for a live demo. Raise to high if you have time.
MODEL_EFFORT=low

# --- Demo insurance ----------------------------------------------------
# USE_STUB=1 runs the entire app with zero network calls, using the offline
# heuristic parser and the rules-only semantic tier. Every endpoint works.
# USE_STUB=1

# --- Storage -----------------------------------------------------------
# Falls back to an in-memory Map automatically if Mongo is unreachable.
MONGO_URI=mongodb://127.0.0.1:27017/resume_fit
# NO_MONGO=1

# --- Channels ----------------------------------------------------------
# From @BotFather. Without it the server runs web-chat only.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# WhatsApp is not wired up: it needs Meta Business verification. See
# server/channels/whatsapp.js.

PORT=3001
